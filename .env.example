# Скопируйте этот файл в .env и заполните нужное. Без .env демо работает на правилах.

# Движок извлечения: auto (Claude, если задан ключ; иначе правила) | rules | claude
ENGINE=auto

# Ключ Anthropic API: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Модель и глубина рассуждений (low | medium | high)
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# 1 = разобрать демо-документы через LLM при первом запуске (5 платных запросов)
SEED_WITH_LLM=0

# Сколько минут сотрудник тратит на ручной ввод одного документа (для оценки экономии)
MANUAL_MINUTES_PER_DOCUMENT=5
